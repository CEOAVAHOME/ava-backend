# Copia questo file in .env.local e compila i valori.
# Ogni chiave è opzionale: se manca, la funzione corrispondente gira in modalità demo.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (PostgreSQL / Supabase) ---
# Supabase: Project Settings → Database → Connection string (usa il pooler "Transaction" su Vercel)
DATABASE_URL=postgresql://postgres:password@localhost:5432/reviewgenius
# Connessione diretta, usata solo da `prisma migrate` (Supabase: porta 5432)
DIRECT_URL=postgresql://postgres:password@localhost:5432/reviewgenius

# --- NextAuth ---
# Genera con: openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (login + Google Business Profile API) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OpenAI ---
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Stripe ---
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_BASE_MONTHLY=
STRIPE_PRICE_BASE_YEARLY=
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_YEARLY=

# --- Automazioni ---
# Segreto per i cron di Vercel (openssl rand -hex 32)
CRON_SECRET=
# Email transazionali via Resend (https://resend.com) — verifica il dominio
RESEND_API_KEY=
EMAIL_FROM=ReviewGenius <ciao@reviewgenius.it>
# Massimo di risposte gratuite al giorno per tutto il sito (protegge la spesa OpenAI)
FREE_TOOL_DAILY_CAP=300

# --- Pannello incassi /admin ---
# Email (separate da virgola) che possono vedere il pannello
ADMIN_EMAILS=
